// VectorOp:8
	vec2 n_in8p1 = vec2(0.00000, 1.00000);
	vec2 n_out8p0 = vec2(n_out7p1) * n_in8p1;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out8p0 * n_in9p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out9p0);
	float n_out2p1 = n_out2p0.r;


// FloatOp:4
	float n_in4p0 = 0.00000;
	float n_out4p0 = n_in4p0 * n_out2p1;


// Output:0
	ALBEDO = vec3(n_out5p0.xyz);
	ALPHA = n_out4p0;


}
"
