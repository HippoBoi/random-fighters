// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out8p0 * n_in9p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out9p0);
	float n_out2p1 = n_out2p0.r;


// FloatParameter:10
