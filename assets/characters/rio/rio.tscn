// VectorOp:13
	vec4 n_out13p0 = n_out2p0 * n_out12p0;


// VectorOp:14
	vec4 n_out14p0 = n_out15p0 * n_out13p0;


// Output:0
	ALBEDO = vec3(n_out14p0.xyz);
	ALPHA = n_out13p0.x;


}
