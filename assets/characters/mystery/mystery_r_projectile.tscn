code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_11;



void fragment() {
// Input:7
	vec4 n_out7p0 = COLOR;
	float n_out7p1 = n_out7p0.r;


	float n_out10p0;
// Remap:10
	float n_in10p1 = 0.00000;
	float n_in10p2 = 1.00000;
	float n_in10p3 = 0.00000;
	float n_in10p4 = 0.70000;
	{
		float __input_range = n_in10p2 - n_in10p1;
		float __output_range = n_in10p4 - n_in10p3;
		n_out10p0 = n_in10p3 + __output_range * ((n_out7p1 - n_in10p1) / __input_range);
	}


// Input:4
	float n_out4p0 = TIME;


// VectorOp:5
	vec2 n_in5p1 = vec2(0.00000, -0.50000);
	vec2 n_out5p0 = vec2(n_out4p0) * n_in5p1;


// UVFunc:3
	vec2 n_in3p1 = vec2(2.00000, 2.00000);
	vec2 n_out3p0 = n_out5p0 * n_in3p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);
	float n_out2p1 = n_out2p0.r;


// SmoothStep:6
	float n_in6p1 = 0.90000;
	float n_out6p0 = smoothstep(n_out10p0, n_in6p1, n_out2p1);


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, vec2(n_out6p0));


// Output:0
	ALBEDO = vec3(n_out11p0.xyz);
	ALPHA = n_out6p0;


}
