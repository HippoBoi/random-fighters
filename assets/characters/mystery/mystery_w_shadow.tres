code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 color2 : source_color;
uniform sampler2D tex_frg_16;
uniform sampler2D tex_frg_17;
uniform vec4 color : source_color;
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_11;
uniform float transparency : hint_range(0.0, 1.0) = 1.0;



void fragment() {
// ColorParameter:19
	vec4 n_out19p0 = color2;


// Texture2D:16
	vec4 n_out16p0 = texture(tex_frg_16, UV);


// Texture2D:17
	vec4 n_out17p0 = texture(tex_frg_17, vec2(n_out16p0.xy));


// VectorOp:18
	vec4 n_out18p0 = n_out19p0 * n_out17p0;


// ColorParameter:14
	vec4 n_out14p0 = color;


// Input:3
	vec2 n_out3p0 = UV;


// VectorOp:6
	vec2 n_in6p1 = vec2(0.25000, 1.00000);
	vec2 n_out6p0 = n_out3p0 * n_in6p1;


// Input:20
	float n_out20p0 = TIME;


// UVFunc:4
	vec2 n_in4p1 = vec2(0.50000, 0.25000);
	vec2 n_out4p0 = vec2(n_out20p0) * n_in4p1 + n_out6p0;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out4p0);


// Input:8
	vec2 n_out8p0 = UV;


// VectorOp:10
	vec2 n_in10p1 = vec2(1.00000, 1.00000);
	vec2 n_out10p0 = n_out8p0 * n_in10p1;


// Input:15
	float n_out15p0 = TIME;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 0.75000);
	vec2 n_out9p0 = vec2(n_out15p0) * n_in9p1 + n_out10p0;


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, n_out9p0);


// VectorOp:12
	vec4 n_out12p0 = n_out2p0 * n_out11p0;


// VectorOp:13
	vec4 n_out13p0 = n_out14p0 * n_out12p0;


// FloatParameter:23
	float n_out23p0 = transparency;


// FloatOp:22
	float n_out22p0 = n_out13p0.x * n_out23p0;


// Output:0
	ALBEDO = vec3(n_out18p0.xyz);
	ALPHA = n_out22p0;


}
